APP_ENV=development
APP_NAME=Manner Buddy API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Comma-separated origins. Add the unpacked/installed Chrome extension ID.
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://YOUR_EXTENSION_ID

USE_MOCK_AI=true
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_EFFORT=medium

MAX_EMAIL_CHARACTERS=5000
ANALYSIS_TIMEOUT_SECONDS=60
MAX_MEETING_CHARACTERS=30000
# The analyses/feedback/quiz_attempts tables use a uuid user_id column, so this
# must be a valid UUID.
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# MVP uses memory. Set to "supabase" once supabase/migrations/001_initial_schema.sql
# has been run against SUPABASE_URL (base project URL, e.g. https://xxxx.supabase.co
# — no /rest/v1 suffix, the app appends that itself).
STORAGE_BACKEND=memory
SUPABASE_URL=
SUPABASE_SECRET_KEY=
