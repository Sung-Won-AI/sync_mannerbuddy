APP_ENV=development
APP_NAME=Manner Buddy API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Comma-separated origins. Add the unpacked/installed Chrome extension ID.
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://YOUR_EXTENSION_ID

USE_MOCK_AI=true
AI_SERVICE_URL=
AI_SERVICE_API_KEY=

MAX_EMAIL_CHARACTERS=5000
ANALYSIS_TIMEOUT_SECONDS=30
MAX_MEETING_CHARACTERS=30000
DEMO_USER_ID=demo-user

# MVP uses memory. Change after implementing the Supabase repository adapter.
STORAGE_BACKEND=memory
SUPABASE_URL=
SUPABASE_SECRET_KEY=
