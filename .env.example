# 이 프로젝트의 모든 API 키/설정은 이 파일 하나로 관리한다.
# 실제 값은 루트에 .env로 복사해서 채우고, 절대 git에 커밋하지 않는다 (.gitignore에 등록됨).

# --- backend (FastAPI) ---
APP_ENV=development
APP_NAME=Manner Buddy API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
# 대시보드 dev 서버 등 CORS 허용 origin (콤마로 구분). Chrome 확장(chrome-extension://*)은 코드에서 별도 허용.
ALLOWED_ORIGINS=http://localhost:5173

# true면 실제 AI 호출 없이 MockAIClient로 이메일 분석 (개발 기본값)
USE_MOCK_AI=true
AI_SERVICE_URL=
AI_SERVICE_API_KEY=

MAX_EMAIL_CHARACTERS=5000
ANALYSIS_TIMEOUT_SECONDS=30

# --- dashboard / extension (Vite, VITE_ 접두사 필수) ---
VITE_API_BASE_URL=http://localhost:8000
